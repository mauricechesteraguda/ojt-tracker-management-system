#!/bin/sh

# feature-10032026-Maurice
# Local fake-provider guard and deterministic bootstrap entrypoint.
set -eu
printf '%s\n' 'event=startup operation=demo-bootstrap status=begin' >&2
[ "${APP_ENV:-local}" = local ] || { printf '%s\n' 'event=failure operation=demo-bootstrap status=nonlocal' >&2; exit 64; }
[ "${PROVIDER_MODE:-fake}" = fake ] || { printf '%s\n' 'event=failure operation=demo-bootstrap status=provider-not-fake' >&2; exit 65; }
rm -f /tmp/ojt-demo-contract
if [ -f /tmp/ojt-demo-bootstrap-complete ]; then
    printf '%s\n' 'event=completion operation=demo-bootstrap status=already-complete' >&2
    exit 0
fi
printf '%s\n' 'event=operation operation=migrate status=begin' >&2
# feature-10032026-Maurice: actively probe Laravel/MariaDB readiness with a
# bounded retry window; the probe is active and does not use a fixed delay.
if ! timeout 60 sh -c '
    attempt=0
    while :; do
        attempt=$((attempt + 1))
        if php artisan migrate --force >/dev/null 2>&1; then
            printf "%s\\n" "event=operation operation=migrate status=ready attempts=$attempt" >&2
            exit 0
        fi
        printf "%s\\n" "event=wait operation=migrate status=retry attempt=$attempt" >&2
        if [ "$attempt" -ge 60 ]; then
            printf "%s\\n" "event=failure operation=migrate status=timeout attempts=$attempt" >&2
            exit 1
        fi
    done
'; then
    printf '%s\n' 'event=failure operation=demo-bootstrap status=db-readiness-timeout' >&2
    exit 1
fi
printf '%s\n' 'event=operation operation=seed status=begin' >&2
php scripts/demo-seed.php >/dev/null
: > /tmp/ojt-demo-bootstrap-complete
printf '%s\n' 'event=completion operation=demo-bootstrap status=complete' >&2
