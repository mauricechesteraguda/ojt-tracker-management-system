#!/bin/sh

# feature-10032026-Maurice
# observability/fix-10042026-Maurice: every subprocess failure is explicit.
# Local fake-provider guard and deterministic bootstrap entrypoint.
set -eu
printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"info","event":"startup","component":"demo-bootstrap","operation":"bootstrap","status":"begin"}' >&2
[ "${APP_ENV:-local}" = local ] || { printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"bootstrap","status":"nonlocal","correlation_id":null,"exception_class":"RuntimeException","error_class":"RuntimeException","error_category":"configuration_failure","message_category":"unsafe_mode","stack":"redacted","cause":"none","remediation":"use_local_environment"}' >&2; exit 64; }
[ "${PROVIDER_MODE:-fake}" = fake ] || { printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"bootstrap","status":"provider-not-fake","correlation_id":null,"exception_class":"RuntimeException","error_class":"RuntimeException","error_category":"configuration_failure","message_category":"provider_mode","stack":"redacted","cause":"none","remediation":"use_fake_provider"}' >&2; exit 65; }
if ! rm -f /tmp/ojt-demo-contract; then
    printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"cleanup","status":"cleanup-failed","correlation_id":null,"exception_class":"RuntimeException","error_category":"bootstrap_cleanup_failure","message_category":"cleanup_failed","stack":"redacted","cause":"none","remediation":"inspect_runtime_storage"}' >&2
    exit 1
fi
if [ -f /tmp/ojt-demo-bootstrap-complete ]; then
    printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"info","event":"completion","component":"demo-bootstrap","operation":"bootstrap","status":"already-complete"}' >&2
    exit 0
fi
printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"info","event":"operation","component":"demo-bootstrap","operation":"migrate","status":"begin"}' >&2
# feature-10032026-Maurice: actively probe Laravel/MariaDB readiness with a
# bounded retry window; the probe is active and does not use a fixed delay.
if ! timeout "${DB_READINESS_TIMEOUT_SECONDS:-60}" sh -c '
    attempt=0
    while :; do
        attempt=$((attempt + 1))
        if php artisan migrate --force >/dev/null 2>&1; then
            printf "%s\\n" "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"level\":\"info\",\"event\":\"operation\",\"component\":\"demo-bootstrap\",\"operation\":\"migrate\",\"status\":\"ready\"}" >&2
            exit 0
        fi
        printf "%s\\n" "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"level\":\"info\",\"event\":\"retry\",\"component\":\"demo-bootstrap\",\"operation\":\"migrate\",\"status\":\"retry\"}" >&2
        if [ "$attempt" -ge 60 ]; then
            printf "%s\\n" "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"level\":\"error\",\"event\":\"failure\",\"component\":\"demo-bootstrap\",\"operation\":\"migrate\",\"status\":\"migration-failed\",\"correlation_id\":null,\"exception_class\":\"RuntimeException\",\"error_category\":\"migration_failure\",\"message_category\":\"migration_failed\",\"stack\":\"redacted\",\"cause\":\"none\",\"remediation\":\"inspect_database_migrations\"}" >&2
            exit 1
        fi
    done
'; then
    printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"bootstrap","status":"db-readiness-timeout","correlation_id":null,"exception_class":"RuntimeException","error_class":"RuntimeException","error_category":"readiness_timeout","message_category":"database_unavailable","stack":"redacted","cause":"none","remediation":"check_database_health"}' >&2
    exit 1
fi
printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"info","event":"operation","component":"demo-bootstrap","operation":"seed","status":"begin"}' >&2
if ! php scripts/demo-seed.php >/dev/null 2>&1; then
    printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"seed","status":"seed-failed","correlation_id":null,"exception_class":"RuntimeException","error_category":"seed_failure","message_category":"seed_failed","stack":"redacted","cause":"none","remediation":"inspect_seed_contract"}' >&2
    exit 1
fi
if ! : > /tmp/ojt-demo-bootstrap-complete; then
    printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"error","event":"failure","component":"demo-bootstrap","operation":"completion-marker","status":"marker-failed","correlation_id":null,"exception_class":"RuntimeException","error_category":"completion_failure","message_category":"marker_failed","stack":"redacted","cause":"none","remediation":"inspect_runtime_storage"}' >&2
    exit 1
fi
printf '%s\n' '{"timestamp":"'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'","level":"info","event":"completion","component":"demo-bootstrap","operation":"bootstrap","status":"complete"}' >&2
